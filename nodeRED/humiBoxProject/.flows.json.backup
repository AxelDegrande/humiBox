    {
        "id": "735f534696e51c4d",
        "type": "function",
        "z": "07be42d7a3f9cfc6",
        "name": "function 1",
        "func": "// Check temperature\n//if (msg.payload.temperature < 10) {\n//    msg.topic = \"Temperature Alert\";\n//    msg.payload = \"Warning: The temperature is below 10C.\\n\" +\n//                  \"Current temperature: \" + msg.payload.temperature + \"C\";\n//\n//   return msg;\n//}\n\n// Get the current status\nvar status = msg.payload.status;\n\n// Get the current error counter\nvar count = context.get(\"tempErrorCount\") || 0;\n\n// Check for temperature error\nif (status === \"error\") {\n    count++;\n    context.set(\"tempErrorCount\", count);\n\n    // Send email after 10 errors\n    if (count >= 10) {\n        msg.topic = \"Temperature Error Alert\";\n        msg.payload = \"Temperature error has occurred 10 times.\";\n\n        // Reset counter after sending email\n        context.set(\"tempErrorCount\", 0);\n\n        return msg;\n    }\n}\n\n\n// Do not send anything if temperature is 20�C or higher\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
